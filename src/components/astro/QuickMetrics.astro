---
/**
 * QuickMetrics.astro
 * Deep navy stat bar displayed immediately below the hero.
 * Stats: Studio | 4 guests | 500 sq ft | Floor 14
 */
import { QUICK_METRICS } from '../../lib/constants';
---

<section style="background: var(--color-primary);" aria-label="Property highlights">
  <div class="max-w-5xl mx-auto px-6 md:px-10 py-8 grid grid-cols-2 md:grid-cols-4 gap-8">
    {QUICK_METRICS.map(({ value, label }) => (
      <div class="metric-stat">
        <span class="metric-stat__value">{value}</span>
        <span class="metric-stat__label">{label}</span>
      </div>
    ))}
  </div>
</section>
