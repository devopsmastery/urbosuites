---
/**
 * GlobalNav.astro
 * Sticky frosted-glass navigation bar.
 * Mobile: hamburger → full-screen navy drawer (CSS-only, no JS).
 * Desktop: smooth-scroll anchor links + gold "Book Now →" CTA.
 */
import { NAV_LINKS, BRAND } from '../../lib/constants';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---

<header
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-10 py-4"
  style="background: rgba(26,39,68,0.96); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);"
>
  <!-- Brand wordmark -->
  <a href="/" class="flex flex-col leading-none" aria-label="UrboSuites home">
    <span
      class="text-white font-bold text-xl tracking-widest"
      style="font-family: var(--font-display);"
    >
      URBO<span style="color: var(--color-accent);">SUITES</span>
    </span>
    <span class="text-[9px] tracking-[0.2em] uppercase mt-0.5" style="color: rgba(255,255,255,0.4);">
      {BRAND.subLabel}
    </span>
  </a>

  <!-- Desktop nav links -->
  <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
    {NAV_LINKS.filter(l => !l.cta).map(link => (
      <a
        href={link.href}
        class="text-sm tracking-wide transition-colors duration-200"
        style={`color: rgba(255,255,255,${currentPath === link.href ? '1' : '0.6'});`}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Desktop CTA + Mobile hamburger -->
  <div class="flex items-center gap-4">
    <a href="/#book" class="btn-gold hidden md:inline-flex" aria-label="Book a stay">
      Book Now
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>

    <!-- CSS-only hamburger (checkbox hack, no JS) -->
    <label
      for="mobile-menu-toggle"
      class="md:hidden flex flex-col gap-[5px] cursor-pointer p-2"
      aria-label="Toggle mobile menu"
    >
      <input type="checkbox" id="mobile-menu-toggle" class="sr-only peer" />
      <span class="block w-5 h-0.5 bg-white transition-transform duration-300 peer-checked:rotate-45 peer-checked:translate-y-[7px]"></span>
      <span class="block w-5 h-0.5 bg-white transition-opacity duration-300 peer-checked:opacity-0"></span>
      <span class="block w-5 h-0.5 bg-white transition-transform duration-300 peer-checked:-rotate-45 peer-checked:-translate-y-[7px]"></span>
    </label>
  </div>
</header>

<!-- Mobile full-screen drawer (shown when checkbox is checked) -->
<div
  id="mobile-nav-drawer"
  class="fixed inset-0 z-40 flex-col gap-6 pt-20 px-8 hidden"
  style="background: var(--color-primary);"
>
  {NAV_LINKS.map(link => (
    <a
      href={link.href}
      class="text-3xl font-bold text-white border-b pb-5 transition-colors duration-200 hover:text-accent"
      style="font-family: var(--font-display); border-color: rgba(255,255,255,0.1);"
      onclick="document.getElementById('mobile-menu-toggle').checked = false;"
    >
      {link.label}
    </a>
  ))}

  <a
    href="/#book"
    class="btn-gold mt-4 self-start"
    onclick="document.getElementById('mobile-menu-toggle').checked = false;"
  >
    Book Now →
  </a>
</div>

<style>
  /* Show mobile drawer when checkbox is checked */
  #mobile-menu-toggle:checked ~ * #mobile-nav-drawer,
  #mobile-menu-toggle:checked + * + #mobile-nav-drawer {
    display: flex;
  }

  /* Rewrite: use global sibling selector from label */
  :global(#mobile-menu-toggle:checked) ~ :global(#mobile-nav-drawer) {
    display: flex;
  }

  /* Simpler approach: toggle via adjacent JS-free CSS */
  .peer:checked ~ #mobile-nav-drawer {
    display: flex !important;
  }
</style>

<script>
  // Minimal JS: sync drawer visibility with checkbox state
  const toggle = document.getElementById('mobile-menu-toggle') as HTMLInputElement;
  const drawer = document.getElementById('mobile-nav-drawer') as HTMLDivElement;

  if (toggle && drawer) {
    toggle.addEventListener('change', () => {
      drawer.style.display = toggle.checked ? 'flex' : 'none';
    });
    // Close on link click
    drawer.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        toggle.checked = false;
        drawer.style.display = 'none';
      });
    });
  }
</script>
