---
/**
 * FaqSection.astro
 * ─────────────────────────────────────────────────────────────
 * Interactive FAQ Accordion targeting long-tail queries and AI
 * Search engines (ChatGPT Search, Perplexity, Gemini).
 * ─────────────────────────────────────────────────────────────
 */
import { FAQ_ITEMS } from '../../lib/seo';
---

<section
  id="faq"
  class="py-24 px-6 md:px-10"
  style="background: #FFFFFF;"
  aria-labelledby="faq-heading"
>
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="label-accent mb-2 block">FREQUENTLY ASKED QUESTIONS</span>
      <h2
        id="faq-heading"
        class="text-3xl md:text-4xl font-bold mb-4 leading-tight"
        style="font-family: var(--font-display); color: var(--color-foreground);"
      >
        Everything you need to know
      </h2>
      <p class="text-sm text-gray-600">
        Common questions about staying at UrboSuites, VJ IndiLife, Pashan Sus Road, Pune.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {FAQ_ITEMS.map((item, index) => (
        <details
          class="faq-item group rounded-xl border border-gray-200 bg-white transition-all duration-200 overflow-hidden"
          open={index === 0}
        >
          <summary
            class="flex items-center justify-between p-5 md:p-6 cursor-pointer list-none select-none font-semibold text-base text-navy hover:text-amber-700 transition-colors"
            style="font-family: var(--font-display);"
          >
            <span class="pr-4">{item.question}</span>
            <span class="shrink-0 w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center border border-gray-200 text-gray-500 group-open:rotate-180 group-open:bg-amber-50 group-open:text-amber-800 transition-transform duration-200">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-6 md:px-6 pt-1 text-sm text-gray-700 leading-relaxed border-t border-gray-100/80">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Direct Support Callout -->
    <div class="mt-12 p-6 rounded-2xl bg-[#F9F8F6] border border-gray-200 text-center">
      <p class="text-sm font-semibold text-gray-900" style="font-family: var(--font-display);">
        Have more questions about your upcoming stay in Pashan?
      </p>
      <p class="text-xs text-gray-500 mt-1">
        We reply within 2 hours on WhatsApp and direct call.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a
          href="https://wa.me/918530585574"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold text-xs py-2.5 px-5 inline-flex items-center gap-2"
        >
          Chat on WhatsApp
        </a>
        <a
          href="tel:+918530585574"
          class="btn-ghost text-xs py-2.5 px-5 inline-flex items-center gap-2 !text-gray-800 !border-gray-300 hover:!bg-white"
        >
          Call Host: +91 8530 58 55 74
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-item[open] {
    box-shadow: 0 4px 18px -2px rgba(17, 24, 39, 0.06);
    border-color: #E2CA76;
  }
</style>
