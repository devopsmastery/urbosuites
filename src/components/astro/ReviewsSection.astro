---
/**
 * ReviewsSection.astro
 * Reads from src/data/testimonials.ts — edit that file to update reviews.
 */
import { testimonials } from '../../data/testimonials';

const StarSVG = `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`;

const PLATFORM_LABEL: Record<string, string> = {
  airbnb: 'Airbnb',
  google: 'Google',
  direct: 'Direct',
};
---

<section
  id="reviews"
  class="py-20 px-6 md:px-10"
  style="background: var(--color-primary);"
  aria-labelledby="reviews-heading"
>
  <div class="max-w-6xl mx-auto">
    <p class="label-accent mb-2">Verified guest stays</p>
    <h2
      id="reviews-heading"
      class="heading-xl heading-xl-white mb-12"
    >
      What guests say
    </h2>

    <div class="grid md:grid-cols-3 gap-5">
      {testimonials.map(r => (
        <article class="review-card">
          <!-- Stars + platform -->
          <div class="flex items-center justify-between">
            <div class="flex gap-0.5" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: r.rating }).map(() => (
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#C9A227" stroke="none" aria-hidden="true">
                  <Fragment set:html={StarSVG} />
                </svg>
              ))}
            </div>
            <span
              class="text-[9px] font-semibold tracking-widest uppercase px-2 py-0.5"
              style="background: rgba(201,162,39,0.15); color: var(--color-accent);"
            >
              {PLATFORM_LABEL[r.platform]}
              {r.verified ? ' ✓' : ''}
            </span>
          </div>

          <!-- Quote -->
          <p class="text-sm leading-relaxed" style="color: rgba(255,255,255,0.8);">
            "{r.text}"
          </p>

          <!-- Guest info -->
          <div
            class="flex items-center gap-3 mt-auto pt-4"
            style="border-top: 1px solid rgba(255,255,255,0.1);"
          >
            <!-- Avatar -->
            <div
              class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold shrink-0"
              style="background: var(--color-accent); color: var(--color-primary);"
              aria-hidden="true"
            >
              {r.name.split(' ').map(n => n[0]).join('')}
            </div>
            <div>
              <p class="text-white text-sm font-medium">{r.name}</p>
              <p class="text-xs" style="color: rgba(255,255,255,0.4);">
                {r.city} · {r.date}{r.suite ? ` · ${r.suite}` : ''}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Overall rating pill -->
    <div class="mt-12 flex items-center justify-center gap-3">
      <div class="flex gap-0.5">
        {Array.from({ length: 5 }).map(() => (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#C9A227" stroke="none" aria-hidden="true">
            <Fragment set:html={StarSVG} />
          </svg>
        ))}
      </div>
      <p class="text-white text-sm">
        <span class="font-bold text-lg">4.95</span>
        <span style="color: rgba(255,255,255,0.5);"> average · 84+ stays on Airbnb</span>
      </p>
    </div>
  </div>
</section>
