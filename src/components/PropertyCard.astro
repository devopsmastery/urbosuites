---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'properties'>;
  tilt?: number;
}

const { entry, tilt = -0.6 } = Astro.props;
const { title, tagline, location, pricePerNight, guests, bedrooms, baths, heroImage } = entry.data;
---

<a
  href={`/properties/${entry.id}/`}
  class="tag-card group block bg-paper-soft border border-line p-3 pt-5 shadow-[3px_4px_0_0_var(--color-line)]"
  style={`--tilt:${tilt}deg`}
>
  <span class="tag-card__grommet" aria-hidden="true"></span>

  <div class="overflow-hidden rounded-sm">
    <img
      src={heroImage}
      alt={title}
      width="900"
      height="700"
      loading="lazy"
      class="w-full h-48 object-cover group-hover:scale-[1.03] transition-transform duration-300"
    />
  </div>

  <div class="pt-4 pb-1">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-lg leading-snug">{title}</h3>
      <p class="font-mono text-sm whitespace-nowrap pt-0.5">
        ${pricePerNight}<span class="text-ink/50">/night</span>
      </p>
    </div>

    <p class="text-sm text-ink/70 mt-1 flex items-center gap-1">
      <Icon name="pin" class="w-3.5 h-3.5" />
      {location}
    </p>

    <p class="text-sm mt-3 leading-relaxed">{tagline}</p>

    <div class="flex items-center gap-4 mt-4 pt-3 border-t border-line font-mono text-xs text-ink/70">
      <span class="flex items-center gap-1"><Icon name="guests" class="w-3.5 h-3.5" />{guests}</span>
      <span class="flex items-center gap-1"><Icon name="bed" class="w-3.5 h-3.5" />{bedrooms} bd</span>
      <span class="flex items-center gap-1"><Icon name="bath" class="w-3.5 h-3.5" />{baths} ba</span>
    </div>
  </div>
</a>
