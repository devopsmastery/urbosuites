---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: Record<string, any>[];
}

const {
  title,
  description = 'UrboSuites offers luxury high-rise studio apartments at VJ IndiLife, Pashan Sus Road, Pune. Enjoy Sahyadri mountain views, 100Mbps Wi-Fi, Super King beds, gym, cafeteria, and zero-fee direct booking.',
  keywords = 'UrboSuites, UrboSuites Pashan, UrboSuites Pune, VJ IndiLife Pashan, studio apartment in Pashan Pune, luxury Airbnb Pashan, serviced apartments Pashan Sus Road, homestay near Hinjewadi, workation Pune with mountain view, UrboSuites booking, Hillcrest Suite Pune, Gulmohar Suite Pune',
  image = '/images/suites/hillcrest/01-Balcony-withTeacups-Final.png',
  type = 'website',
  noindex = false,
  schemas = [],
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : 'https://urbosuites.in';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageURL = image.startsWith('http') ? image : new URL(image, siteOrigin).toString();

const pageTitle = title === 'Home'
  ? 'UrboSuites — Studio Apartments in Pashan, Pune | VJ IndiLife'
  : `${title} | UrboSuites Pashan, Pune`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── Canonical & Indexing Directives ────────────────────────── -->
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}

    <!-- ── Primary Search Engine Meta ─────────────────────────────── -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="UrboSuites" />
    <meta name="publisher" content="UrboSuites" />
    <meta name="theme-color" content="#1A2744" />
    <meta name="color-scheme" content="light" />

    <!-- ── Local SEO & Geo Tags (Pashan, Pune) ────────────────────── -->
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Pashan, Pune, Maharashtra, India" />
    <meta name="geo.position" content="18.5483;73.7744" />
    <meta name="ICBM" content="18.5483, 73.7744" />

    <!-- ── Open Graph / Facebook / WhatsApp ───────────────────────── -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="UrboSuites" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="UrboSuites private balcony overlooking lush green hills in Pashan, Pune" />
    <meta property="og:locale" content="en_IN" />

    <!-- ── Twitter Cards ──────────────────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@urbosuites" />
    <meta name="twitter:creator" content="@urbosuites" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="UrboSuites Pashan Pune" />

    <!-- ── Favicon & App Icons ────────────────────────────────────── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- ── Google & AI Search JSON-LD Structured Data ─────────────── -->
    {schemas.map((schemaObj) => (
      <script type="application/ld+json" set:html={JSON.stringify(schemaObj)} />
    ))}

    <!-- ── Google Fonts: Raleway (display) + Inter (body) ─────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Preload hero image on critical routes -->
    <slot name="head-preload" />
  </head>

  <body>
    <!-- Accessibility Skip Link -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-accent focus:text-primary focus:px-4 focus:py-2 focus:font-bold focus:text-sm"
    >
      Skip to main content
    </a>

    <!-- Page Body -->
    <main id="main">
      <slot />
    </main>
  </body>
</html>
