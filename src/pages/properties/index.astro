---
/**
 * src/pages/properties/index.astro
 * /properties — All active suites listing page
 */
import Layout from '../../layouts/Layout.astro';
import GlobalNav from '../../components/astro/GlobalNav.astro';
import Footer from '../../components/astro/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getSuiteImages } from '../../lib/images';

const suites = (await getCollection('properties', e => e.data.isActive))
  .sort((a, b) => a.data.order - b.data.order);

const StarSVG = `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`;
---

<Layout
  title="Our Suites — Studio Apartments at VJ IndiLife, Pashan"
  description="Explore Hillcrest (Suite 201) and Gulmohar (Suite 101) studio serviced apartments at VJ IndiLife, Pashan Sus Road, Pune. Fast 100Mbps Wi-Fi, mountain views, and direct booking."
  keywords="UrboSuites, UrboSuites Pashan, studio apartments Pashan Pune, VJ IndiLife Building C, Hillcrest Suite, Gulmohar Suite, short term rentals Pune, workation Pune"
>
  <GlobalNav currentPath="/properties" />

  <!-- Page header -->
  <section
    class="pt-32 pb-16 px-6 md:px-10"
    style="background: var(--color-primary);"
  >
    <div class="max-w-4xl mx-auto">
      <p class="label-accent mb-3">VJ IndiLife · Pashan, Pune</p>
      <h1
        class="text-white text-4xl md:text-6xl font-bold leading-tight"
        style="font-family: var(--font-display);"
      >
        Our suites
      </h1>
      <p class="mt-4 text-base max-w-xl leading-relaxed" style="color: rgba(255,255,255,0.6);">
        {suites.length} studio{suites.length !== 1 ? 's' : ''} available.
        Book directly — no platform fees, no middlemen.
      </p>
    </div>
  </section>

  <!-- Suite cards -->
  <section class="py-20 px-6 md:px-10 max-w-5xl mx-auto">
    <div class="flex flex-col gap-16">
      {suites.map(suite => {
        const imgs = getSuiteImages(suite.id);
        const hero = imgs[0];
        return (
          <article class="grid md:grid-cols-2 gap-10 items-center">
            <!-- Photo -->
            <div class="gallery-item overflow-hidden" style="aspect-ratio: 4/3;">
              {hero && (
                <Image
                  src={hero}
                  alt={suite.data.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  widths={[600, 900]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
              )}
            </div>

            <!-- Info -->
            <div class="flex flex-col gap-4">
              <div>
                <span
                  class="text-xs font-semibold px-2 py-1 mb-3 inline-block"
                  style="background: var(--color-secondary); color: var(--color-muted-foreground); text-transform: uppercase; letter-spacing: 0.1em;"
                >
                  {suite.data.roomType}
                </span>
                <h2
                  class="text-2xl md:text-3xl font-bold mt-2"
                  style="font-family: var(--font-display); color: var(--color-foreground);"
                >
                  {suite.data.title}
                </h2>
                <p class="mt-1 text-sm" style="color: var(--color-muted-foreground);">
                  {suite.data.tagline}
                </p>
              </div>

              <!-- Rating -->
              <div class="flex items-center gap-1.5">
                {Array.from({ length: 5 }).map(() => (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#C9A227" stroke="none" aria-hidden="true">
                    <Fragment set:html={StarSVG} />
                  </svg>
                ))}
                <span class="text-sm ml-1 font-medium">{suite.data.rating.toFixed(1)}</span>
                <span class="text-sm" style="color: var(--color-muted-foreground);">
                  ({suite.data.reviewCount} reviews)
                </span>
              </div>

              <!-- Specs -->
              <div class="grid grid-cols-2 gap-4">
                <div class="spec-badge">
                  <span class="spec-badge__label">Bed</span>
                  <span class="spec-badge__value">{suite.data.bedType}</span>
                </div>
                <div class="spec-badge">
                  <span class="spec-badge__label">Guests</span>
                  <span class="spec-badge__value">Up to {suite.data.maxGuests}</span>
                </div>
                <div class="spec-badge">
                  <span class="spec-badge__label">Check-in</span>
                  <span class="spec-badge__value">{suite.data.checkIn}</span>
                </div>
                <div class="spec-badge">
                  <span class="spec-badge__label">Check-out</span>
                  <span class="spec-badge__value">{suite.data.checkOut}</span>
                </div>
              </div>

              <!-- Price + CTA -->
              <div class="flex items-center justify-between mt-2">
                <div>
                  <p
                    class="text-3xl font-bold"
                    style="font-family: var(--font-display); color: var(--color-foreground);"
                  >
                    ₹{suite.data.pricePerNight.toLocaleString('en-IN')}
                    <span class="text-base font-normal" style="color: var(--color-muted-foreground);">/night</span>
                  </p>
                  <p class="text-xs mt-0.5" style="color: var(--color-muted-foreground);">No platform fees</p>
                </div>
                <a href={`/properties/${suite.id}`} class="btn-gold">
                  View suite →
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Back to home -->
    <div class="mt-20 text-center">
      <a
        href="/#book"
        class="btn-gold"
      >
        Book directly →
      </a>
    </div>
  </section>

  <Footer />
</Layout>
