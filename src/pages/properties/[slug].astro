---
/**
 * src/pages/properties/[slug].astro
 * Individual suite detail page — /properties/hillcrest, /properties/gulmohar
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GlobalNav from '../../components/astro/GlobalNav.astro';
import Footer from '../../components/astro/Footer.astro';
import SuitePhotoSlider from '../../components/react/SuitePhotoSlider';
import BookingWidget from '../../components/react/BookingWidget';
import MobileStickyBar from '../../components/react/MobileStickyBar';
import { getSuiteImages, getGalleryImages } from '../../lib/images';
import { CONTACT, ADDRESS } from '../../lib/constants';
import { getAccommodationSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const properties = await getCollection('properties');
  return properties.map(entry => ({
    params: { slug: entry.id },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// All images for this suite
const allImgs = getSuiteImages(entry.id);
const heroImg = allImgs[0];
const galleryImgs = getGalleryImages(entry.id);

// Serialise for React
const serialized = allImgs.map(img => ({
  src: img.src, width: img.width, height: img.height, format: img.format,
}));

// Widget data
const suiteForWidget = [{
  slug: entry.id,
  title: d.title,
  pricePerNight: d.pricePerNight,
}];

const StarSVG = `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`;
const price = `₹${d.pricePerNight.toLocaleString('en-IN')}`;

const accommodationSchema = getAccommodationSchema({
  id: entry.id,
  title: d.title,
  tagline: d.tagline,
  pricePerNight: d.pricePerNight,
  maxGuests: d.maxGuests,
  bedType: d.bedType,
  sqft: d.sqft,
  floor: d.floor,
  rating: d.rating,
  reviewCount: d.reviewCount,
  heroImage: heroImg?.src || '/images/suites/hillcrest/01-Balcony-withTeacups-Final.png',
});
---

<Layout
  title={`${d.title} — Luxury Studio at VJ IndiLife, Pashan`}
  description={`${d.title} at VJ IndiLife Building C, Pashan Sus Road, Pune. ${d.tagline}. High-speed 100Mbps Wi-Fi, Super King bed, full kitchen, mountain views, and zero platform booking fees.`}
  keywords={`${d.title}, UrboSuites, UrboSuites Pashan, studio apartment Pashan Pune, VJ IndiLife Pune, Pashan Sus Road rentals, workation Pune`}
  image={heroImg?.src}
  schemas={[accommodationSchema]}
>
  <link
    slot="head-preload"
    rel="preload"
    as="image"
    href={heroImg?.src}
  />

  <GlobalNav />

  <!-- Breadcrumb -->
  <nav
    class="fixed top-[72px] left-0 right-0 z-40 px-6 md:px-10 py-2 text-xs flex items-center gap-2"
    style="background: var(--color-secondary); border-bottom: 1px solid var(--color-border);"
    aria-label="Breadcrumb"
  >
    <a href="/" style="color: var(--color-muted-foreground);">Home</a>
    <span style="color: var(--color-border-dark);">›</span>
    <a href="/properties" style="color: var(--color-muted-foreground);">Suites</a>
    <span style="color: var(--color-border-dark);">›</span>
    <span style="color: var(--color-foreground); font-weight: 500;">{d.title}</span>
  </nav>

  <div class="pt-[104px]">

    <!-- ── Photo slider + quick info ──────────────────────────── -->
    <section class="px-6 md:px-10 py-10 max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-10 items-start">

        <!-- Photos -->
        <div>
          <SuitePhotoSlider
            client:idle
            photos={serialized}
            suiteName={d.title}
          />

          <!-- Thumbnail strip -->
          {galleryImgs.length > 0 && (
            <div class="mt-3 flex gap-2 overflow-x-auto pb-1" role="list" aria-label="Photo thumbnails">
              {allImgs.map((img, i) => (
                <div
                  class="flex-shrink-0 overflow-hidden"
                  style="width: 72px; height: 54px;"
                  role="listitem"
                >
                  <img
                    src={img.src}
                    alt={`${d.title} photo ${i + 1}`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Key info -->
        <div class="flex flex-col gap-6">
          <div>
            <p class="label-accent mb-2">{d.location}</p>
            <h1
              class="text-3xl md:text-4xl font-bold leading-tight"
              style="font-family: var(--font-display); color: var(--color-foreground);"
            >
              {d.title}
            </h1>
            <p class="mt-2" style="color: var(--color-success); font-size: 0.875rem; font-weight: 500;">
              {d.tagline}
            </p>
          </div>

          <!-- Rating -->
          <div class="flex items-center gap-1.5">
            {Array.from({ length: 5 }).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#C9A227" stroke="none" aria-hidden="true">
                <Fragment set:html={StarSVG} />
              </svg>
            ))}
            <span class="font-semibold ml-1">{d.rating.toFixed(1)}</span>
            <span style="color: var(--color-muted-foreground); font-size: 0.875rem;">
              · {d.reviewCount} verified reviews
            </span>
          </div>

          <!-- Specs grid -->
          <div class="grid grid-cols-2 gap-4">
            <div class="spec-badge">
              <span class="spec-badge__label">Type</span>
              <span class="spec-badge__value">{d.roomType}</span>
            </div>
            <div class="spec-badge">
              <span class="spec-badge__label">Bed</span>
              <span class="spec-badge__value">{d.bedType}</span>
            </div>
            <div class="spec-badge">
              <span class="spec-badge__label">Guests</span>
              <span class="spec-badge__value">Up to {d.maxGuests}</span>
            </div>
            <div class="spec-badge">
              <span class="spec-badge__label">Area</span>
              <span class="spec-badge__value">{d.sqft} sq ft</span>
            </div>
            <div class="spec-badge">
              <span class="spec-badge__label">Check-in</span>
              <span class="spec-badge__value">{d.checkIn}</span>
            </div>
            <div class="spec-badge">
              <span class="spec-badge__label">Check-out</span>
              <span class="spec-badge__value">{d.checkOut}</span>
            </div>
          </div>

          <!-- Price + primary CTA -->
          <div
            class="flex items-center justify-between p-5"
            style="background: var(--color-secondary); border-left: 3px solid var(--color-accent);"
          >
            <div>
              <p
                class="text-3xl font-bold"
                style="font-family: var(--font-display); color: var(--color-foreground);"
              >
                {price}
                <span class="text-base font-normal" style="color: var(--color-muted-foreground);">/night</span>
              </p>
              <p class="text-xs mt-0.5" style="color: var(--color-muted-foreground);">
                No platform fees · Free cancellation
              </p>
            </div>
            <a href="#book" class="btn-gold">
              Book Now →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Description ─────────────────────────────────────────── -->
    <section class="px-6 md:px-10 py-14 max-w-4xl mx-auto">
      <div class="mb-8">
        <span class="label-accent">SUITE OVERVIEW</span>
        <h2
          class="text-3xl md:text-4xl font-bold mt-2"
          style="font-family: var(--font-display); color: var(--color-foreground);"
        >
          About this suite
        </h2>
      </div>

      <div
        class="about-prose"
        style="color: var(--color-foreground);"
      >
        <Content />
      </div>

      <script>
        // Ensure callout styling applies to paragraphs beginning with a strong tag (e.g. Good to know)
        document.querySelectorAll('.about-prose p').forEach(p => {
          const firstChild = p.firstElementChild;
          if (firstChild && firstChild.tagName === 'STRONG') {
            p.classList.add('prose-callout-gold');
          }
        });
      </script>

      <style is:global>
        /* Editorial Typography & Spacing for About this suite — High Contrast Light Theme */
        .about-prose {
          max-width: 100%;
        }

        .about-prose p {
          font-size: 1.0625rem !important;  /* 17px reading size */
          line-height: 1.95 !important;     /* generous editorial leading */
          color: #1F2937 !important;        /* deep charcoal for crystal-clear readability */
          margin-top: 0 !important;
          margin-bottom: 1.85rem !important; /* clear 30px paragraph separation */
          letter-spacing: -0.01em;
        }

        .about-prose p:last-child {
          margin-bottom: 0 !important;
        }

        .about-prose strong {
          color: #1A2744 !important;        /* Urbo navy for bold emphasis */
          font-weight: 700;
        }

        /* ── LUXURY GOLDEN-EDGED CARD for "Good to know:" / "Practical details:" ── */
        .about-prose p:has(strong:first-child),
        .about-prose .prose-callout-gold,
        .about-prose blockquote {
          position: relative;
          background: linear-gradient(135deg, #FFFDF8 0%, #FAF5EA 100%) !important; /* warm champagne cream */
          border: 1.5px solid #E4CD83 !important;                                    /* warm gold outline */
          border-left: 6px solid #C9A227 !important;                                 /* prominent solid Urbo gold bar */
          border-radius: 14px !important;
          padding: 1.5rem 1.85rem !important;
          margin-top: 2.75rem !important;
          margin-bottom: 2rem !important;
          box-shadow: 0 8px 30px -4px rgba(201, 162, 39, 0.14), 0 2px 8px -2px rgba(0, 0, 0, 0.04) !important;
          color: #2D3748 !important;                                                 /* rich dark charcoal text */
          line-height: 1.85 !important;
        }

        .about-prose p:has(strong:first-child) strong:first-child,
        .about-prose .prose-callout-gold strong:first-child {
          display: block;                                                           /* clean headline line */
          color: #1A2744 !important;                                                /* Urbo navy */
          font-size: 0.95rem;
          font-weight: 800;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          margin-bottom: 0.45rem;
          font-family: var(--font-display);
        }
      </style>
    </section>

    <!-- ── Amenities ───────────────────────────────────────────── -->
    <section
      class="px-6 md:px-10 py-14"
      style="background: var(--color-secondary);"
    >
      <div class="max-w-4xl mx-auto">
        <h2
          class="text-2xl font-bold mb-8"
          style="font-family: var(--font-display); color: var(--color-foreground);"
        >
          What's included
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          {d.amenities.map(a => (
            <div
              class="flex items-center gap-2 px-4 py-3"
              style="background: var(--color-card); border: 1px solid var(--color-border);"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <span class="text-sm">{a}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Booking form ────────────────────────────────────────── -->
    <section
      id="book"
      class="px-6 md:px-10 py-20"
    >
      <div class="max-w-5xl mx-auto grid md:grid-cols-5 gap-14 items-start">

        <!-- Left: info -->
        <div class="md:col-span-2">
          <p class="label-accent mb-3">Reserve your stay</p>
          <h2
            class="text-3xl font-bold mb-4 leading-tight"
            style="font-family: var(--font-display); color: var(--color-foreground);"
          >
            Book {d.title}
          </h2>
          <p class="text-sm leading-relaxed mb-6" style="color: var(--color-muted-foreground);">
            We confirm within 2 hours. No payment required until your booking is confirmed.
          </p>

          <!-- Contact shortcuts -->
          <div class="flex flex-col gap-3">
            <a
              href={CONTACT.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-sm"
              style="color: var(--color-foreground);"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12 19.79 19.79 0 0 1 1.08 3.4 2 2 0 0 1 3.06 1.23h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 8 8l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {CONTACT.phone}
            </a>
            <a
              href={CONTACT.emailHref}
              class="flex items-center gap-3 text-sm"
              style="color: var(--color-foreground);"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              {CONTACT.email}
            </a>

            <!-- Map -->
            <div class="mt-2 overflow-hidden" style="border: 1px solid var(--color-border);">
              <iframe
                title={`Map — ${d.location}`}
                src={ADDRESS.mapsEmbed}
                width="100%"
                height="180"
                style="border: 0; display: block;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
              <a
                href={ADDRESS.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-1.5 py-2.5 text-xs"
                style="background: var(--color-secondary); color: var(--color-foreground);"
              >
                Open in Google Maps →
              </a>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="md:col-span-3">
          <BookingWidget client:visible suites={suiteForWidget} />
        </div>
      </div>
    </section>

    <!-- ── Other suite ─────────────────────────────────────────── -->
    <section
      class="py-14 px-6 md:px-10 text-center"
      style="background: var(--color-primary);"
    >
      <p class="label-accent mb-3">Also available</p>
      <h2
        class="text-white text-2xl font-bold mb-4"
        style="font-family: var(--font-display);"
      >
        Explore our other suite
      </h2>
      <a href="/properties" class="btn-gold">View all suites →</a>
    </section>

    <Footer />
  </div>

  <MobileStickyBar client:load price={price} bookHref="#book" />
</Layout>
