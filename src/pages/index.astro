    <!-- Client-side script for tab filtering & interactive lightbox -->
    <script>
      // Filter tabs logic
      const tabs = document.querySelectorAll('.fac-tab');
      const sections = document.querySelectorAll('.fac-section');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          const target = tab.getAttribute('data-target');
          if (target === 'all') {
            sections.forEach(s => (s as HTMLElement).style.display = 'block');
          } else {
            sections.forEach(s => {
              const el = s as HTMLElement;
              el.style.display = el.id === target ? 'block' : 'none';
            });
          }
        });
      });

      // Lightbox logic
      const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.fac-lightbox-trigger'));
      const lightbox = document.getElementById('facility-lightbox');
      const flImg = document.getElementById('fl-img') as HTMLImageElement | null;
      const flCategory = document.getElementById('fl-category');
      const flTitle = document.getElementById('fl-title');
      const flCounter = document.getElementById('fl-counter');
      const flClose = document.getElementById('fl-close');
      const flPrev = document.getElementById('fl-prev');
      const flNext = document.getElementById('fl-next');

      let currentIdx = 0;

      function openLightbox(index: number) {
        if (!lightbox || !flImg || index < 0 || index >= triggers.length) return;
        currentIdx = index;
        const trigger = triggers[currentIdx];
        const src = trigger.getAttribute('data-img') || '';
        const name = trigger.getAttribute('data-name') || '';
        const category = trigger.getAttribute('data-category') || '';

        flImg.src = src;
        flImg.alt = name;
        if (flTitle) flTitle.textContent = name;
        if (flCategory) flCategory.textContent = category;
        if (flCounter) flCounter.textContent = `${currentIdx + 1} / ${triggers.length}`;

        lightbox.classList.remove('hidden');
        requestAnimationFrame(() => {
          lightbox.classList.remove('opacity-0');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.add('opacity-0');
        setTimeout(() => {
          lightbox.classList.add('hidden');
          document.body.style.overflow = '';
        }, 250);
      }

      function showPrev() {
        openLightbox((currentIdx - 1 + triggers.length) % triggers.length);
      }

      function showNext() {
        openLightbox((currentIdx + 1) % triggers.length);
      }

      triggers.forEach((trigger, idx) => {
        trigger.addEventListener('click', () => openLightbox(idx));
      });

      flClose?.addEventListener('click', closeLightbox);
      flPrev?.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });
      flNext?.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });

      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) {
          closeLightbox();
        }
      });

      window.addEventListener('keydown', (e) => {
        if (!lightbox || lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') showPrev();
        if (e.key === 'ArrowRight') showNext();
      });
    </script>

    <style>
      .fac-tab {
        background: #ffffff;
        color: #4B5563;
        border: 1px solid #E5E7EB;
      }
      .fac-tab:hover {
