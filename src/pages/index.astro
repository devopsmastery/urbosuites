---
/**
 * src/pages/index.astro — UrboSuites Homepage
 *
 * Full UI/UX Implementation:
 * 1. Hero: High-contrast balcony & Sahyadri hill view with dual gradient overlay
 * 2. QuickMetrics: Key studio specs
 * 3. Our Suites: Hillcrest (Suite 201) first, Gulmohar (Suite 101) with bed hero
 * 4. Facilities: Categorized into Building/Entrance first, then Gym (all 8 photos together),
 *    Cafeteria/Workspaces, and Terraces. Includes interactive category filter tabs.
 * 5. Mood Break: "Chai. Clouds. Complete quiet."
 * 6. About the Studio: "Designed for people who notice details" with generous spacing
 * 7. Amenities: 12-item luxury grid with gold icons
 * 8. Reviews: Powered by src/data/testimonials.ts
 * 9. Book: Inquiry form with live total and Google Maps
 * 10. Footer: Contact, navigation, and location
 */
import Layout from '../layouts/Layout.astro';
import GlobalNav from '../components/astro/GlobalNav.astro';
import QuickMetrics from '../components/astro/QuickMetrics.astro';
import MoodBreak from '../components/astro/MoodBreak.astro';
import AmenitiesMatrix from '../components/astro/AmenitiesMatrix.astro';
import ReviewsSection from '../components/astro/ReviewsSection.astro';
import FaqSection from '../components/astro/FaqSection.astro';
import Footer from '../components/astro/Footer.astro';
import SuitePhotoSlider from '../components/react/SuitePhotoSlider';
import BookingWidget from '../components/react/BookingWidget';
import MobileStickyBar from '../components/react/MobileStickyBar';
import { getCollection } from 'astro:content';
import { CONTACT, ADDRESS } from '../lib/constants';
import { getLodgingBusinessSchema, getFaqSchema } from '../lib/seo';

// ── Dynamic image imports (auto-discovers new files at build/dev time) ─
const hillcrestModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/suites/hillcrest/*',
  { eager: true }
);
const gulmoharModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/suites/gulmohar/*',
  { eager: true }
);
const amenityModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/amenities/*',
  { eager: true }
);

function sortedImages(modules: Record<string, { default: ImageMetadata }>): ImageMetadata[] {
  return Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }))
    .map(([, m]) => m.default);
}

const hillcrestImages = sortedImages(hillcrestModules);
const gulmoharImages  = sortedImages(gulmoharModules);

// Hero image: Balcony with chai cups overlooking green misty hills (01-Balcony-withTeacups-Final.png)
const heroImg = hillcrestImages[0];

// ── Facility images grouped by module path (bulletproof matching) ──
interface FacilityItem {
  name: string;
  img: ImageMetadata;
}

const amenityEntries = Object.entries(amenityModules).map(([path, mod]) => {
  const rawFilename = path.split('/').pop()?.replace(/\.[^.]+$/, '') || '';
  const cleanName = rawFilename
    .replace(/^(\d+[-_]?)/, '')                  // remove leading sorting numbers (e.g. 01-)
    .replace(/([a-z])([A-Z])/g, '$1 $2')          // split CamelCase: GrandEntrance -> Grand Entrance
    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')    // handle acronyms: GYMArea -> GYM Area
    .replace(/terrage/gi, 'Terrace')              // autocorrect typo
    .replace(/[-_]/g, ' ')                       // hyphens/underscores to spaces
    .replace(/\s+/g, ' ')                        // collapse double spaces
    .trim();
  return {
    path: path.toLowerCase(),
    filename: rawFilename.toLowerCase(),
    cleanName,
    img: mod.default,
  };
});

// Category 1: Building Exterior & Grand Entrance (3 photos, dedicated 3-column layout)
const exteriorOrder = [
  { key: 'exterior-grandentrance', name: 'Grand Entrance & Landscaped Driveway' },
  { key: 'exterior-building facade', name: 'High-Rise Architectural Facade' },
  { key: 'exterior-building', name: 'VJ IndiLife Community Overview' },
];
const exteriorImages: FacilityItem[] = exteriorOrder
  .map(target => {
    const found = amenityEntries.find(e => e.filename === target.key);
    return found ? { name: target.name, img: found.img } : null;
  })
  .filter((item): item is FacilityItem => Boolean(item));

// Category 2: Gym & Fitness (5 photos, 1-Hero + 4-Card Bento layout)
const gymOrder = [
  { key: 'gym.png', name: 'Fitness Center & Cardio Overview' },
  { key: 'open-gym', name: 'Podium Open-Air Fitness Deck' },
  { key: 'gym-bench press', name: 'Commercial Bench Press & Racks' },
  { key: 'gym-cross training machine', name: 'Cross Trainer & Aerobics' },
  { key: 'gym-bicycles', name: 'Spin Bikes & Endurance Area' },
];
const gymImages: FacilityItem[] = gymOrder
  .map(target => {
    const found = amenityEntries.find(e => e.filename.includes(target.key) || e.path.includes(target.key));
    return found ? { name: target.name, img: found.img } : null;
  })
  .filter((item): item is FacilityItem => Boolean(item));

// Category 3: Cafeteria, Meeting Rooms & Facilities (Curated 5 photos, 1-Hero + 4-Card Bento layout, mirrors Terrace)
const cafeOrder = [
  { key: 'cafeteria-1stfloor', name: 'Resident Cafeteria (1st Floor)' },
  { key: 'meetingroom-1stfloor', name: 'Meeting & Work Room (1st Floor)' },
  { key: 'lobby-waiting area', name: 'Grand Lobby & Reception Lounge' },
  { key: 'lobby-hangout', name: 'Resident Lounge & Hangout' },
  { key: 'laundromat-basement', name: 'Basement Laundromat' },
];
const cafeteriaImages: FacilityItem[] = cafeOrder
  .map(target => {
    const found = amenityEntries.find(e => e.filename === target.key || e.path.includes(target.key));
    return found ? { name: target.name, img: found.img } : null;
  })
  .filter((item): item is FacilityItem => Boolean(item));

// Category 4: Rooftop Terraces (Curated 5 photos, 1-Hero + 4-Card Bento layout)
const terraceOrder = [
  { key: 'terrage-largedeck', name: 'Rooftop Observation Deck' },
  { key: 'terrage-mountainview', name: 'Panoramic Sahyadri Mountain View' },
  { key: 'terrace-garden', name: 'Sky Garden & Landscaped Lawn' },
  { key: 'terrace-yoga deck', name: 'Sunrise Yoga & Meditation Deck' },
  { key: 'terrace-view from top', name: '360° Valley Panorama' },
];
const terraceImages: FacilityItem[] = terraceOrder
  .map(target => {
    const found = amenityEntries.find(e => e.filename === target.key || e.path.includes(target.key));
    return found ? { name: target.name, img: found.img } : null;
  })
  .filter((item): item is FacilityItem => Boolean(item));

const facilitySections = [
  {
    id: 'cat-exterior',
    tag: 'ARCHITECTURE & ARRIVAL',
    title: 'Building Exterior & Grand Entrance',
    description: 'Secure gated community at VJ IndiLife with landscaped driveway, covered parking, and 24/7 manned security.',
    layout: 'grid-3' as const,
    items: exteriorImages,
  },
  {
    id: 'cat-gym',
    tag: 'FITNESS & WELLNESS',
    title: 'Fully Equipped Gym & Workout Deck',
    description: 'State-of-the-art fitness center with commercial cardio equipment, dedicated free weights zone, and open-air stretching area.',
    layout: 'bento-5' as const,
    items: gymImages,
  },
  {
    id: 'cat-cafe',
    tag: 'SPACES & PRODUCTIVITY',
    title: 'Cafeteria, Meeting Rooms & Facilities',
    description: 'Ground & 1st floor amenities including resident café, quiet meeting rooms, resident lounge, and basement laundromat.',
    layout: 'bento-5' as const,
    items: cafeteriaImages,
  },
  {
    id: 'cat-terrace',
    tag: 'PANORAMIC VIEWS',
    title: 'Rooftop Terrace & Sun Deck',
    description: 'Expansive open terrace with shaded gazebos, seating zones, and sweeping 360° views across the Sahyadri mountains.',
    layout: 'bento-5' as const,
    items: terraceImages,
  },
];

const totalFacilityPhotos = facilitySections.reduce((acc, s) => acc + s.items.length, 0);

// ── Suites Collection ─────────────────────────────────────────
const allSuites = await getCollection('properties', e => e.data.isActive);
const suites = allSuites.sort((a, b) => a.data.order - b.data.order);

const suiteImageMap: Record<string, ImageMetadata[]> = {
  hillcrest: hillcrestImages,
  gulmohar:  gulmoharImages,
};

function serializeImages(imgs: ImageMetadata[]) {
  return imgs.map(img => ({ src: img.src, width: img.width, height: img.height, format: img.format }));
}

const suitesForWidget = suites.map(s => ({
  slug: s.id,
  title: s.data.title,
  pricePerNight: s.data.pricePerNight,
}));

const startingPrice = `₹${Math.min(...suites.map(s => s.data.pricePerNight)).toLocaleString('en-IN')}`;

const StarSVG = `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`;

const lodgingSchema = getLodgingBusinessSchema();
const faqSchema = getFaqSchema();
---

<Layout
  title="Home"
  description="UrboSuites offers luxury studio serviced apartments at VJ IndiLife, Pashan Sus Road, Pune. Features 100Mbps Wi-Fi, Sahyadri mountain views, gym, cafeteria, and zero-fee direct booking."
  keywords="UrboSuites, UrboSuites Pashan, UrboSuites Pune, VJ IndiLife Pashan, studio apartment in Pashan Pune, luxury Airbnb Pashan, serviced apartments Pashan Sus Road, homestay near Hinjewadi, workation Pune with mountain view, UrboSuites booking, Hillcrest Suite Pune, Gulmohar Suite Pune"
  schemas={[lodgingSchema, faqSchema]}
>
  <link slot="head-preload" rel="preload" as="image" href={heroImg.src} />

  <GlobalNav />

  <!-- ════════════════════════════════════════════════════════
       1. HERO — High Contrast & Emotionally Resonant
  ═══════════════════════════════════════════════════════════ -->
  <section
    class="relative flex items-end overflow-hidden"
    style="height: 100svh; min-height: 640px;"
    aria-label="Welcome to UrboSuites"
  >
    <!-- Background Hero Photo: Balcony with Tea Cups overlooking vibrant green hills -->
    <img
      src={heroImg.src}
      alt="UrboSuites private balcony overlooking lush green Sahyadri hills in Pashan, Pune"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      width={heroImg.width}
      height={heroImg.height}
    />

    <!--
      UI/UX Designer Multi-Layer Gradient:
      1. Dark navy wash on the left to guarantee 100% white/gold text readability
      2. Bottom gradient providing solid ground for CTAs and metrics
    -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to right, rgba(13,22,43,0.92) 0%, rgba(13,22,43,0.72) 42%, rgba(13,22,43,0.25) 100%);"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to top, rgba(13,22,43,0.95) 0%, rgba(13,22,43,0.35) 45%, transparent 100%);"
      aria-hidden="true"
    ></div>

    <!-- Hero Content -->
    <div class="relative z-10 px-6 md:px-14 pb-20 md:pb-28 max-w-3xl w-full">
      <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full mb-6 border border-white/20 bg-white/10 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full" style="background: var(--color-accent);"></span>
        <span class="text-xs font-semibold tracking-widest uppercase text-white/90" style="font-family: var(--font-display);">
          Studio Apartments · Pashan, Pune
        </span>
      </div>

      <h1
        class="font-bold leading-[1.05] mb-6 text-white"
        style="font-family: var(--font-display); font-size: clamp(2.6rem, 6.2vw, 4.8rem); text-shadow: 0 4px 24px rgba(0,0,0,0.45);"
      >
        Urban living.<br />
        <span style="color: var(--color-accent); text-shadow: 0 2px 20px rgba(201,162,39,0.35);">Forest views.</span>
      </h1>

      <p class="text-base md:text-lg leading-relaxed max-w-xl mb-10 text-white/90" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
        A smartly designed studio at VJ IndiLife, Pashan. Step onto your private balcony with steaming chai,
        surrounded by quiet hills, 100Mbps Wi-Fi, full kitchen, and 24/7 security.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a href="#book" class="btn-gold shadow-lg shadow-yellow-900/20">
          Check Availability
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#gallery" class="btn-ghost backdrop-blur-sm">View Facilities</a>
      </div>
    </div>

    <!-- Floating Price & Rating Chip -->
    <div
      class="price-chip absolute bottom-20 md:bottom-28 right-6 md:right-14 hidden sm:block p-5 rounded-xl border border-white/30 shadow-2xl"
      style="background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(14px);"
    >
      <p class="text-[11px] tracking-[0.18em] uppercase font-semibold mb-1" style="color: var(--color-muted-foreground);">
        Direct Booking From
      </p>
      <p class="text-3xl font-bold" style="font-family: var(--font-display); color: var(--color-primary);">
        ₹2,399<span class="text-sm font-normal text-gray-500"> / night</span>
      </p>
      <div class="flex items-center gap-1.5 mt-2 pt-2 border-t border-gray-200">
        <div class="flex gap-0.5">
          {Array.from({ length: 5 }).map(() => (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#C9A227" stroke="none" aria-hidden="true">
              <Fragment set:html={StarSVG} />
            </svg>
          ))}
        </div>
        <span class="text-xs font-semibold text-gray-700">4.95 · 84+ verified stays</span>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       2. QUICK METRICS
  ═══════════════════════════════════════════════════════════ -->
  <QuickMetrics />

  <!-- ════════════════════════════════════════════════════════
       3. OUR SUITES (Hillcrest 201 First, Gulmohar 101 Second)
  ═══════════════════════════════════════════════════════════ -->
  <section id="suites" class="py-20 px-6 md:px-10 max-w-6xl mx-auto" aria-labelledby="suites-heading">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <p class="label-accent mb-2">VJ IndiLife, Pashan · Pune</p>
        <h2 id="suites-heading" class="heading-xl">Our suites</h2>
        <p class="text-sm text-gray-500 mt-2 max-w-lg">
          Both suites feature super king beds, dedicated workspaces, smart TV, full kitchen, and unblocked views.
        </p>
      </div>
      <span class="text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200 bg-gray-50 text-gray-600 self-start md:self-auto">
        {suites.length} Suites Available
      </span>
    </div>

    <div class="grid sm:grid-cols-2 gap-8">
      {suites.map(suite => {
        const imgs = suiteImageMap[suite.id] ?? [];
        const serialized = serializeImages(imgs);
        return (
          <article class="flex flex-col gap-3 group bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <SuitePhotoSlider client:idle photos={serialized} suiteName={suite.data.title} />

            <div class="flex flex-col gap-1.5 px-1 pt-2">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-bold text-lg leading-tight" style="font-family: var(--font-display); color: var(--color-foreground);">
                  {suite.data.title}
                </h3>
                <div class="flex items-center gap-1 shrink-0 px-2 py-0.5 rounded bg-amber-50 border border-amber-200">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="#C9A227" stroke="none" aria-hidden="true">
                    <Fragment set:html={StarSVG} />
                  </svg>
                  <span class="text-xs font-bold text-amber-900">{suite.data.rating.toFixed(1)}</span>
                </div>
              </div>
              <p class="text-sm text-gray-600">{suite.data.bedType} · Up to {suite.data.maxGuests} guests · {suite.data.sqft} sq ft</p>
              <p class="text-sm mt-0.5">
                <span class="font-bold text-lg" style="font-family: var(--font-display); color: var(--color-primary);">
                  ₹{suite.data.pricePerNight.toLocaleString('en-IN')}
                </span>
                <span class="text-gray-500 text-xs"> / night · No platform fees</span>
              </p>
              <p class="text-xs font-medium text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded inline-block self-start mt-1">
                {suite.data.tagline}
              </p>
              <a href={`/properties/${suite.id}`}
                class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold tracking-wider uppercase"
                style="color: var(--color-accent); font-family: var(--font-display);">
                View Details & Specs →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       4. FACILITIES — Categorized Architecture, Gym & Spaces
  ═══════════════════════════════════════════════════════════ -->
  <section
    id="gallery"
    class="py-24"
    style="background: #F4F6F9;"
    aria-labelledby="gallery-heading"
  >
    <div class="max-w-6xl mx-auto px-6 md:px-10 mb-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div>
          <p class="label-accent mb-2">SHARED BUILDING AMENITIES</p>
          <h2 id="gallery-heading" class="heading-xl">World-class facilities</h2>
          <p class="text-sm text-gray-600 mt-2 max-w-xl">
            Guests enjoy complimentary access to VJ IndiLife’s podium gym, rooftop observation decks, landscaped greens, and resident spaces.
          </p>
        </div>

        <!-- Interactive Category Quick Filter Tabs -->
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Facility categories">
          <button class="fac-tab active px-4 py-2 text-xs font-semibold rounded-full transition-all" data-target="all">
            All ({totalFacilityPhotos})
          </button>
          <button class="fac-tab px-4 py-2 text-xs font-semibold rounded-full transition-all" data-target="cat-exterior">
            Building & Entrance (3)
          </button>
          <button class="fac-tab px-4 py-2 text-xs font-semibold rounded-full transition-all" data-target="cat-gym">
            Gym & Fitness (5)
          </button>
          <button class="fac-tab px-4 py-2 text-xs font-semibold rounded-full transition-all" data-target="cat-cafe">
            Café & Spaces (5)
          </button>
          <button class="fac-tab px-4 py-2 text-xs font-semibold rounded-full transition-all" data-target="cat-terrace">
            Terraces (5)
          </button>
        </div>
      </div>
    </div>

    <!-- Facility Sections: Exterior (3-col), Gym (5-bento), Cafeteria (5-bento), Terrace (5-bento) -->
    <div class="max-w-6xl mx-auto px-6 md:px-10 space-y-16">
      {facilitySections.map((sec) => (
        <div id={sec.id} class="fac-section bg-white p-6 md:p-8 rounded-2xl border border-gray-200/80 shadow-sm">
          <!-- Section Header with Category Badge & Description -->
          <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-6 border-b border-gray-100 gap-3">
            <div>
              <span class="text-[11px] font-bold tracking-widest uppercase text-amber-700 bg-amber-50 px-2.5 py-1 rounded">
                {sec.tag}
              </span>
              <h3 class="text-2xl font-bold mt-2" style="font-family: var(--font-display); color: var(--color-primary);">
                {sec.title}
              </h3>
              <p class="text-sm text-gray-500 mt-1">{sec.description}</p>
            </div>
            <span class="text-xs font-semibold text-gray-500 bg-gray-100 px-3 py-1 rounded-full self-start md:self-auto">
              {sec.items.length} photos
            </span>
          </div>

          <!-- Bento-5 Layout: 1 Hero (2 cols x 2 rows) + 4 Symmetrical Surrounding Cards (2x2) -->
          {sec.layout === 'bento-5' && (
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              {sec.items.map((item, idx) => (
                <button
                  type="button"
                  class={`fac-lightbox-trigger group relative overflow-hidden rounded-xl bg-gray-100 shadow-sm transition-all duration-300 hover:shadow-lg text-left cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/50 ${
                    idx === 0 ? 'col-span-2 row-span-2 aspect-[4/3] md:aspect-auto' : 'aspect-[4/3]'
                  }`}
                  data-img={item.img.src}
                  data-name={item.name}
                  data-category={sec.title}
                  aria-label={`View full photo: ${item.name}`}
                >
                  <img
                    src={item.img.src}
                    alt={item.name}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width={item.img.width}
                    height={item.img.height}
                  />
                  <!-- Gradient for readability -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-95 transition-opacity"></div>

                  <!-- Hover Expand Icon -->
                  <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center text-white/90 opacity-0 group-hover:opacity-100 transition-all duration-200 transform group-hover:scale-105 shadow-sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
                    </svg>
                  </div>

                  <!-- Label and Badge -->
                  <div class="absolute bottom-3 left-3 right-3 text-white">
                    {idx === 0 && (
                      <span class="inline-block text-[10px] font-bold tracking-widest uppercase bg-amber-400 text-navy px-1.5 py-0.5 rounded mb-1 shadow-sm font-sans">
                        FEATURED
                      </span>
                    )}
                    <p class="text-xs md:text-sm font-semibold tracking-wide drop-shadow-sm line-clamp-1">
                      {item.name}
                    </p>
                  </div>
                </button>
              ))}
            </div>
          )}

          <!-- Grid-3 Layout: 3 Equal-Width High-Impact Columns -->
          {sec.layout === 'grid-3' && (
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {sec.items.map((item, idx) => (
                <button
                  type="button"
                  class="fac-lightbox-trigger group relative overflow-hidden rounded-xl bg-gray-100 shadow-sm transition-all duration-300 hover:shadow-lg text-left cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/50 aspect-[16/10] md:aspect-[4/3]"
                  data-img={item.img.src}
                  data-name={item.name}
                  data-category={sec.title}
                  aria-label={`View full photo: ${item.name}`}
                >
                  <img
                    src={item.img.src}
                    alt={item.name}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width={item.img.width}
                    height={item.img.height}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-95 transition-opacity"></div>

                  <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center text-white/90 opacity-0 group-hover:opacity-100 transition-all duration-200 transform group-hover:scale-105 shadow-sm">
