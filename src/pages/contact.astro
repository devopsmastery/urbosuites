---
/**
 * src/pages/contact.astro — Contact UrboSuites
 */
import Layout from '../layouts/Layout.astro';
import GlobalNav from '../components/astro/GlobalNav.astro';
import Footer from '../components/astro/Footer.astro';
import { CONTACT, ADDRESS } from '../lib/constants';
import { getLodgingBusinessSchema } from '../lib/seo';

const lodgingSchema = getLodgingBusinessSchema();
---

<Layout
  title="Contact UrboSuites — Pashan, Pune"
  description="Get in touch with UrboSuites at VJ IndiLife Building C, Pashan Sus Road, Pune. Call or WhatsApp +91 8530 58 55 74 for direct booking inquiries, long stays, and corporate rates."
  keywords="Contact UrboSuites, UrboSuites Pashan phone, UrboSuites WhatsApp, VJ IndiLife Building C contact, stay in Pashan Pune"
  schemas={[lodgingSchema]}
>
  <GlobalNav currentPath="/contact" />

  <!-- Page Header -->
  <section class="pt-36 pb-16 px-6 md:px-10" style="background: var(--color-primary);">
    <div class="max-w-4xl mx-auto text-center">
      <span class="label-accent mb-3 block">RESERVATIONS & SUPPORT</span>
      <h1
        class="text-white text-4xl md:text-6xl font-bold leading-tight"
        style="font-family: var(--font-display);"
      >
        Contact Us
      </h1>
      <p class="mt-4 text-base md:text-lg max-w-xl mx-auto leading-relaxed text-white/80">
        Have a question about availability, extended workations, or travel directions to VJ IndiLife in Pashan? We reply promptly.
      </p>
    </div>
  </section>

  <!-- Contact Cards & Map -->
  <section class="py-20 px-6 md:px-10 max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <!-- Phone / WhatsApp -->
      <div class="p-8 rounded-2xl bg-white border border-gray-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 mb-6">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12 19.79 19.79 0 0 1 1.08 3.4 2 2 0 0 1 3.06 1.23h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 8 8l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-2" style="font-family: var(--font-display); color: var(--color-primary);">Call or WhatsApp</h3>
          <p class="text-sm text-gray-600 mb-4">Direct communication with host. Available 9:00 AM – 9:00 PM IST.</p>
        </div>
        <div class="space-y-2 pt-4 border-t border-gray-100">
          <a href={CONTACT.phoneTel} class="text-base font-semibold text-navy hover:text-amber-600 block transition-colors">
            {CONTACT.phone}
          </a>
          <a
            href={CONTACT.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-700 hover:text-emerald-800"
          >
            Chat on WhatsApp →
          </a>
        </div>
      </div>

      <!-- Email -->
      <div class="p-8 rounded-2xl bg-white border border-gray-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 mb-6">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-2" style="font-family: var(--font-display); color: var(--color-primary);">Email Enquiries</h3>
          <p class="text-sm text-gray-600 mb-4">For long-term corporate rentals, partnership inquiries, and booking details.</p>
        </div>
        <div class="pt-4 border-t border-gray-100">
          <a href={CONTACT.emailHref} class="text-base font-semibold text-navy hover:text-amber-600 block transition-colors">
            {CONTACT.email}
          </a>
          <span class="text-xs text-gray-500 mt-1 block">Replies within 2 hours</span>
        </div>
      </div>

      <!-- Location -->
      <div class="p-8 rounded-2xl bg-white border border-gray-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 mb-6">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-2" style="font-family: var(--font-display); color: var(--color-primary);">Address</h3>
          <p class="text-sm text-gray-600 mb-4">
            {ADDRESS.building}<br />
            {ADDRESS.road}, {ADDRESS.locality}<br />
            {ADDRESS.city}, {ADDRESS.state} {ADDRESS.pin}
          </p>
        </div>
        <div class="pt-4 border-t border-gray-100">
          <a
            href={ADDRESS.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-amber-700 hover:text-amber-800"
          >
            Open in Google Maps →
          </a>
        </div>
      </div>
    </div>

    <!-- Map & Directions -->
    <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm bg-white">
      <div class="p-6 md:p-8 bg-gray-50 border-b border-gray-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h3 class="text-xl font-bold text-navy" style="font-family: var(--font-display); color: var(--color-primary);">
            How to reach VJ IndiLife, Pashan
          </h3>
          <p class="text-xs text-gray-500 mt-1">
            Located right on Pashan Sus Road. Landmarks include Indian Institute of Science Education and Research (IISER) and Pashan Circle.
          </p>
        </div>
        <a href={ADDRESS.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-gold text-xs py-2 px-4 self-start md:self-auto">
          Navigate with GPS →
        </a>
      </div>
      <iframe
        title="UrboSuites location — VJ IndiLife, Pashan, Pune"
        src={ADDRESS.mapsEmbed}
        width="100%"
        height="380"
        style="border: 0; display: block;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <Footer />
</Layout>
