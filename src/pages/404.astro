---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="max-w-xl mx-auto px-5 py-24 text-center">
    <p class="font-mono text-xs tracking-widest text-pine uppercase mb-4">404</p>
    <h1 class="font-display text-3xl md:text-4xl mb-4">This page checked out early</h1>
    <p class="text-ink/70 mb-8">
      The page you're looking for doesn't exist. Try one of these instead.
    </p>
    <div class="flex justify-center gap-6">
      <a href="/" class="underline underline-offset-4 hover:text-ember">Home</a>
      <a href="/properties" class="underline underline-offset-4 hover:text-ember">Properties</a>
      <a href="/contact" class="underline underline-offset-4 hover:text-ember">Contact</a>
    </div>
  </section>
</Layout>
